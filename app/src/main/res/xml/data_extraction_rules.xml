<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules pentru Android 12+ (API 31+).
    Includem DOAR baza de date Room. Restul domeniilor sunt excluse automat.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
