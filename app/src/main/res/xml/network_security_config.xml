<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config — MVP hardening
    - Blochează HTTP plain-text (permite doar HTTPS)
    - Permite comunicarea localhost pentru debug builds
    - Previne certificate pinning bypass attacks
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permite localhost doar în debug (pentru dev tools) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
</network-security-config>
